# PASO 1: Copiar este archivo como .env.local
# PASO 2: Reemplazar DATABASE_URL con la cadena de conexión de Neon
DATABASE_URL="postgresql://USUARIO:CONTRASENA@HOST/neondb?sslmode=require"

# Crear con PowerShell:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_DE_64_CARACTERES"

# ATLAS V4: secreto para proteger la tarea diaria /api/cron/sync.
# Generar OTRO secreto distinto al JWT_SECRET (64 caracteres hex).
# Configurarlo en Vercel -> Project -> Settings -> Environment Variables.
CRON_SECRET="REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO_DE_64_CARACTERES"

# Integración opcional con SENTINEL V2. Usá la URL del servidor de SENTINEL.
# En local, si ATLAS usa :3000 y SENTINEL :3001, configurá http://localhost:3001
SENTINEL_URL=""
# Clave creada en SENTINEL > Integrations para la aplicación ATLAS.
# Solo backend; nunca usar NEXT_PUBLIC_ para esta clave.
SENTINEL_API_KEY=""
